# English Teacher — Environment Variables
# ─────────────────────────────────────────
# Copia este archivo como .env y rellena los valores:
#   cp .env.example .env

# ── Groq API ──────────────────────────────
# Obtén tu key gratuita en https://console.groq.com
GROQ_API_KEY=gsk_TU_API_KEY_AQUI

# Modelo Groq a usar:
#   llama-3.1-8b-instant    → más rápido (recomendado)
#   llama-3.3-70b-versatile → mejor calidad
#   gemma2-9b-it            → alternativa ligera
GROQ_MODEL=llama-3.1-8b-instant

# ── Orpheus TTS ───────────────────────────
# Voces disponibles: tara · leah · jess · leo · dan · mia · zac · zoe
ORPHEUS_VOICE=tara
ORPHEUS_SPEED=1.0
ORPHEUS_TTS_URL=http://localhost:5005/v1/audio/speech

# ── Kokoro TTS (mlx-audio) ────────────────
# Inglés americano: af_heart · af_bella · af_nova · af_sky · am_adam · am_echo
# Inglés británico: bf_alice · bf_emma · bm_daniel · bm_george
KOKORO_MODEL=mlx-community/Kokoro-82M-bf16
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_TTS_URL=http://localhost:8000/v1/audio/speech

# ── Whisper STT ───────────────────────────
# Tamaños: tiny.en (más rápido) · base.en (equilibrado) · small.en (más preciso)
WHISPER_MODEL=base.en

# ── Conversación ──────────────────────────
# Número máximo de turnos a recordar en el historial
MAX_HISTORY=12
